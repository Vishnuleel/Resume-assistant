# Copy this file to .env and add a key for at least one provider. Never commit .env.
# You only need ONE of these. Groq and Gemini are free.

# Groq (free, no credit card): https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: which provider AI settings starts on (groq, gemini, openai, ollama).
# If unset, the first provider with a key above is used.
# LLM_PROVIDER=groq

# Optional: custom endpoints
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Set to 1 when hosting for other people (Render's render.yaml does this):
# server keys above are ignored, Ollama is hidden and rate limits apply.
# PUBLIC_MODE=1
